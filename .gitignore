# ============================================
# Meal Share — Comprehensive .gitignore
# ============================================

# ─── Eclipse IDE ───
.metadata/
**/.metadata/
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache
bin/

# ─── IntelliJ IDEA ───
.idea/
*.iws
*.iml
*.ipr
out/

# ─── VS Code ───
.vscode/
*.code-workspace

# ─── OS Files ───
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
*.swp
*.swo
*~

# ─── Java / Maven Build ───
target/
build/
*.class
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar
hs_err_pid*
replay_pid*

# ─── Maven Wrapper — only ignore the binary jar ───
.mvn/wrapper/maven-wrapper.jar

# ─── Node.js / Frontend ───
node_modules/
dist/
*.tsbuildinfo
.next/
.nuxt/

# ─── Environment Files ───
.env
.env.local
.env.*.local
.env.development.local
.env.production.local
.env.test.local

# ─── Logs ───
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
vite_server.log
vite_out.txt
vite_err.txt
build_out.txt
build_err.txt
err.txt
build_output.txt
temp_vite_log.txt

# ─── Testing / Coverage ───
coverage/
.nyc_output/
__pycache__/
*.pyc

# ─── AI / Editor Agent Files ───
.freebuff/
.agents/
.hintrc

# ─── IDE Temp Files ───
*.tmp
*.temp
~$*

# ─── Dependency directories ───
vendor/
bower_components/

# ─── Old unused backend static files (Vue.js replaced Thymeleaf) ───
backend/src/main/resources/static/
backend/src/main/resources/templates/
backend/src/main/resources/static/images/

# ─── Frontend public/ dir (contains only index.html + favicon — not needed) ───
frontend/food-saver-front-lib/public/

# ─── Temp files created during development ───
final_git_status.txt
git_status_final.txt
status_final.txt
status_out.txt
git-cleanup.bat
git-cleanup.cmd

# ─── Misc ───
*.pem
*.p12
*.key
*.crt
*.log.*
